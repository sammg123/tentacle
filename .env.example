# TENTACLE configuration. Copy to .env and `set -a; source .env; set +a` before running,
# or export the ones you want. The ONLY thing required to run is CONTACT_EMAIL
# (and it already defaults to the owner's address in config.py).

# ---- the three "fill these in" inputs ----
CONTACT_EMAIL=goldfedergpt@gmail.com      # SEC EDGAR requires a contact in the User-Agent
BROKER=alpaca                              # alpaca | simulator | robinhood
STARTING_CAPITAL=1000                      # the TOP rung target ($); ladder climbs toward it

# ---- safety (off by default) ----
TENTACLE_ARMED=false                       # must be true before ANY order is placed
CASH_ACCOUNT=true                          # track settled vs unsettled cash (T+1), avoid GFV

# ---- Alpaca (you already have a paper account) ----
# Either ALPACA_* or APCA_* names work. Paper by default.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# ---- optional free keys: each auto-lights one extra tentacle ----
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=
FMP_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ANTHROPIC_API_KEY=                         # optional token-API fallback for the decider

# ---- the Claude decision-maker (Claude decides BUY/PASS + conviction; rules clamp size) ----
TENTACLE_CLAUDE_BACKEND=auto               # auto | cli | api | off
                                           #   auto: `claude` CLI (your subscription, no tokens),
                                           #   then ANTHROPIC_API_KEY, then free heuristic judge.
                                           #   off: pure deterministic heuristic, no LLM.
# TENTACLE_CLAUDE_MODEL=                    # global model override (both roles)
# TENTACLE_KID_MODEL=claude-sonnet-4-6      # the trader: fast + cheap, fires often
# TENTACLE_MOTHER_MODEL=claude-opus-4-8     # the coach: deepest reasoning, runs rarely
# TENTACLE_CLAUDE_TIMEOUT=90                # seconds per decision call

# ---- the Mother (meta-learning coach) tuning ----
# MOTHER_GUARDIAN_IN_LOOP=true              # run the cheap financial guardian every cycle
# MOTHER_DRAWDOWN_ALERT=0.20                # early-warning drawdown (above the -40% ruin death)
# MOTHER_LOSS_STREAK=4                      # consecutive losses before an alert
# MOTHER_AUTO_DEFENSIVE=false               # disarm automatically on a drawdown alert
# MOTHER_MIN_NEW_DECISIONS=15               # skip the heavy review until this many new decisions
# MOTHER_PROMOTION_COOLDOWN_H=168           # min hours between policy promotions (~weekly)
# MOTHER_MIN_AB_SAMPLES=12                  # resolved forward-A/B pairs needed to judge on real edge
# MOTHER_AB_EDGE_MARGIN=0.005               # challenger must beat champion mean drift by this

# ---- optional tentacle inputs ----
TENTACLE_WATCHLIST=                        # comma-separated tickers; default is a built-in basket
TENTACLE_RSS_FEEDS=                        # comma-separated RSS URLs (RSSHub/Nitter/Telegram mirrors of fast X accounts)
TENTACLE_HQ_COORDS=                        # for the ADS-B tentacle, e.g. "AAPL:37.33,-122.03"

# ---- optional tuning overrides (sane defaults in config.py) ----
# MIN_SOURCES=2
# MIN_FAMILIES=2
# EARLINESS_MAX_RUNUP=0.04
# PER_TRADE_STOP_PCT=0.08
# DAILY_LOSS_HALT_PCT=0.10
# RUIN_FLOOR_PCT=0.40
# MAX_OPEN_POSITIONS=3
# TENTACLE_LOG_LEVEL=INFO
