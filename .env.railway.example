# Railway environment variables for TENTACLE (always-on, API backend).
# Set these in the Railway dashboard (Service -> Variables). Do NOT commit real secrets.
# See DEPLOY.md for the full walkthrough.

CONTACT_EMAIL=goldfedergpt@gmail.com
BROKER=alpaca
STARTING_CAPITAL=1000

# Alpaca PAPER account (stays paper until the mother approves graduation)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# Safe by default: only shadow-logs until you ARM and the bot has earned a funded rung
TENTACLE_ARMED=false
CASH_ACCOUNT=true

# Claude via the Anthropic API (the subscription CLI is not available in a container)
TENTACLE_CLAUDE_BACKEND=api
ANTHROPIC_API_KEY=
TENTACLE_KID_MODEL=claude-sonnet-4-6   # the trader: fast + cheaper, fires often
TENTACLE_MOTHER_MODEL=claude-opus-4-8  # the coach: deepest reasoning, runs rarely
TENTACLE_LLM_DAILY_CALL_CAP=60      # hard daily ceiling on Claude calls; 0 = unlimited

# Persist the learning DB on a Railway volume mounted at /data
TENTACLE_DB=/data/tentacle.db

# Optional free tentacles (add keys to light them up)
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=
FMP_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
